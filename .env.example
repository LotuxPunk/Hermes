# Hermes Configuration

# Folder paths
CONTACT_FORM_CONFIGS_FOLDER=/path/to/contact_form_configs
MAIL_CONFIGS_FOLDER=/path/to/mail_configs
TEMPLATES_FOLDER=/path/to/templates

# Mail Queue System
# Enable queue-based email sending with rate limiting (default: true)
USE_MAIL_QUEUE=true

# Maximum emails to send per second (default: 10)
# Adjust based on your email provider's rate limits
# - Resend: Typically 10-20/sec depending on plan
# - SMTP: Varies by provider
MAIL_RATE_LIMIT=10

# Visitor confirmation
# Maximum Visitor confirmations one address receives per day, across every contact form
# config (default: 3). Values that are not a positive integer fall back to 3.
CONFIRMATION_RECIPIENT_DAILY_LIMIT=3
